# Copy this file to .env. AI remains disabled until explicitly enabled here.
AGENT_ENABLED=0
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
MODEL_TIMEOUT=90

# Required only when AGENT_ENABLED=1. Set your own positive total cap in CNY.
# Existing usage is retained. Do not delete the ledger to reset the cap.
MODEL_BUDGET_CNY=
